{
  "expo": {
    "name": "Ritual: Weekly Reset",
    "slug": "ritual-reset",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF7F2"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ritual.reset"
    },
    "android": {
      "package": "com.ritual.reset"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "scheme": "ritual",
    "experiments": {
      "typedRoutes": true
    }
  }
}

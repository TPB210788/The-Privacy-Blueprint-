# Netlify security headers (optional). Ignored by GitHub Pages and Vercel.
# Vercel users: the same values can go in a vercel.json "headers" block.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self'; form-action 'self' https:; base-uri 'self'; frame-ancestors 'none'

# ============================================
# LIFE DASHBOARD — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to git

# Server
PORT=3000
NODE_ENV=production

# Dashboard URL (used in email links)
DASHBOARD_URL=https://your-dashboard-url.com

# Security — REQUIRED
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string-minimum-32-chars

# Dashboard password — REQUIRED
# This is what you use to log into your dashboard
DASHBOARD_PASSWORD=your-secure-password-here

# Your name (shows on dashboard and emails)
USER_NAME=Your Name

# Timezone (for cron jobs and date display)
TIMEZONE=America/New_York

# Database path (optional, defaults to ./data/dashboard.db)
# DB_PATH=/data/dashboard.db

# ============================================
# EMAIL REMINDERS (optional but recommended)
# ============================================
# Use a Gmail address with an App Password
# How to get Gmail App Password:
#   1. Go to myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Go to App Passwords
#   4. Create a new app password for "Mail"

EMAIL_USER=yourname@gmail.com
EMAIL_PASS=your-gmail-app-password-here
EMAIL_TO=yourname@gmail.com
EMAIL_TIME=07:30

# ============================================
# NOTION INTEGRATION (optional)
# ============================================
# How to get your Notion API token:
#   1. Go to https://www.notion.so/my-integrations
#   2. Click "+ New integration"
#   3. Name it "Life Dashboard"
#   4. Copy the Internal Integration Token
#
# How to get your Database ID:
#   1. Open your Notion database in browser
#   2. Copy the ID from the URL:
#      notion.so/workspace/DATABASE_ID_HERE?v=...

NOTION_TOKEN=secret_your-notion-integration-token-here
NOTION_DATABASE_ID=your-notion-database-id-here
